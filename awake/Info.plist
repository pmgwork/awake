<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Stable by default. AppUpdater selects the beta feed only with opt-in. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/PMGWork/awake/update-feeds/stable.xml</string>
	<key>SUPublicEDKey</key>
	<string>0Fy0NadcsAe7hxe9+GEQEUmhEko8rhVDEQOOh+q/LU8=</string>
	<!-- Awake manages the "check automatically" preference in its own settings. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Verify the EdDSA signature before extracting a downloaded update. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- Do not send anonymous system profiling data to the update server. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
</dict>
</plist>
